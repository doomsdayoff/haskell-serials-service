cabal-version:      2.4
name:               serials-api
version:            0.2.0.0
synopsis:           REST API каталога сериалов на Servant
author:             Владислав Фёдоров
build-type:         Simple
extra-source-files: serials.json
                    README.md

common warnings
    ghc-options:      -Wall
    default-language: Haskell2010

library
    import:           warnings
    hs-source-dirs:   src
    exposed-modules:  Serials.Types
                      Serials.Query
                      Serials.Storage
                      Serials.API
                      Serials.Server
    build-depends:    base           >=4.14 && <5
                    , aeson          >=2.0
                    , containers
                    , mtl
                    , servant        >=0.19
                    , servant-server >=0.19
                    , stm
                    , text
                    , wai

executable serials-api
    import:           warnings
    hs-source-dirs:   app/api
    main-is:          Main.hs
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
    build-depends:    base
                    , serials-api
                    , wai-extra
                    , warp

executable serials-cli
    import:           warnings
    hs-source-dirs:   app/cli
    main-is:          Main.hs
    build-depends:    base
                    , serials-api
                    , text

test-suite spec
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-depends:    base
                    , serials-api
                    , HUnit >=1.6
                    , text
